# Local infrastructure
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=rootpass
REDIS_URL=redis://localhost:6379

# Service ports
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
TASK_SERVICE_PORT=3002
REMINDER_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
AI_SERVICE_PORT=3005
ANALYTICS_SERVICE_PORT=3006
CLOUD_SYNC_SERVICE_PORT=3007

# API Gateway hardening
API_AUTH_ENABLED=false
API_AUTH_MODE=token
API_AUTH_TOKEN=change-me
API_JWT_SECRET=change-me-jwt-secret
API_JWT_ISSUER=ed-task-gateway
API_JWT_AUDIENCE=ed-task-clients
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
REQUEST_TIMEOUT_MS=5000
DOWNSTREAM_MAX_RETRIES=2
INTERNAL_CALLER_NAME=api-gateway
INTERNAL_SHARED_SECRET=change-me-internal-secret
INTERNAL_SIGNATURE_MAX_SKEW_MS=60000
INTERNAL_AUTH_ENFORCE=true
INTERNAL_TRUSTED_SERVICE_NAME=api-gateway
EVENT_BUS_SHARED_SECRET=change-me-event-bus-secret
EVENT_SIGNATURE_ENFORCE=true
TASK_CREATE_RATE_LIMIT_WINDOW_MS=60000
TASK_CREATE_RATE_LIMIT_MAX=50
REMINDER_TASK_EVENTS_RATE_MAX=100
REMINDER_TASK_EVENTS_RATE_DURATION_MS=1000
REMINDER_DUE_RATE_MAX=50
REMINDER_DUE_RATE_DURATION_MS=1000
NOTIFICATION_SEND_RATE_MAX=50
NOTIFICATION_SEND_RATE_DURATION_MS=1000

# Analytics alerting
ALERTING_ENABLED=true
ALERT_POLL_INTERVAL_MS=15000
ALERT_NO_EVENTS_WINDOW_MS=120000
ALERT_MAX_QUEUE_WAITING=100
ALERT_MAX_QUEUE_FAILED=20

# Alert routing integrations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/REPLACE_ME
PAGERDUTY_ROUTING_KEY=replace-with-pagerduty-routing-key

# Grafana credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Local MongoDB service databases
USER_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_user_service?authSource=admin
TASK_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_task_service?authSource=admin
REMINDER_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_reminder_service?authSource=admin
NOTIFICATION_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_notification_service?authSource=admin
AI_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_ai_service?authSource=admin
ANALYTICS_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_analytics_service?authSource=admin

# Google Drive cloud sync
GOOGLE_DRIVE_PROJECT_ID=your-google-cloud-project-id
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=ed-task-backups
CLOUD_SYNC_INTERVAL_MS=300000
CLOUD_SYNC_BACKUP_PREFIX=ed-task
CLOUD_SYNC_RESTORE_ON_START=false
