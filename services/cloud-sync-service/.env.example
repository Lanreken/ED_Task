PORT=3007
CLOUD_SYNC_INTERVAL_MS=300000
CLOUD_SYNC_BACKUP_PREFIX=ed-task
CLOUD_SYNC_RESTORE_ON_START=false

# Google Drive service account credentials
GOOGLE_DRIVE_PROJECT_ID=your-google-cloud-project-id
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=ed-task-backups

# Source databases
USER_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_user_service?authSource=admin
TASK_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_task_service?authSource=admin
REMINDER_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_reminder_service?authSource=admin
NOTIFICATION_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_notification_service?authSource=admin
AI_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_ai_service?authSource=admin
ANALYTICS_SERVICE_MONGO_URI=mongodb://root:rootpass@localhost:27017/ed_analytics_service?authSource=admin
